# Variables the Gauntlet runner (npm run gauntlet) reads. Set them in your shell or a local .env;
# never commit real values. The extension itself keeps its key in FastPilot's Settings.

# Model API key. Falls back to OPENROUTER_API_KEY, OPENAI_API_KEY, GROQ_API_KEY or CEREBRAS_API_KEY.
FASTPILOT_API_KEY=
# Optional overrides. The defaults are OpenRouter and anthropic/claude-haiku-5.5.
FASTPILOT_MODEL=
FASTPILOT_BASE_URL=
# Your OpenRouter key, also used for TypeSafe's Jev (--jev shadow or finish).
OPENROUTER_API_KEY=
